# BlindsBook-IA URL for window frame detection (optional, local/self-hosted).
# When set, the app calls POST /ocr/window-frame first; if missing or fails, falls back to Gemini then local.
# Example: http://localhost:4000 (BlindsBook-IA running in Docker or npm run dev)
VITE_BLINDSBOOK_IA_URL=http://localhost:4000

# Google Gemini API key for window frame detection (optional fallback).
# Get a key at https://aistudio.google.com/apikey
# Copy this file to .env and set your key. Do not commit .env
VITE_GEMINI_API_KEY=your_api_key_here

# Azure Vision backend (recommended for real-time object detection).
# Example: http://localhost:4100
VITE_VISION_BACKEND_URL=http://localhost:4100
